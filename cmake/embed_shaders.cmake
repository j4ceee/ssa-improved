# Embeds the compiled pixel shaders of the mod into a generated .cpp, as byte arrays

string(REPLACE "|" ";" FILE_LIST "${FILES}")

set(ARRAYS "")
set(TABLE "")
set(INDEX 0)
foreach(BIN_FILE ${FILE_LIST})
    get_filename_component(BIN_NAME "${BIN_FILE}" NAME_WE)
    file(READ "${BIN_FILE}" BIN_HEX HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BIN_BYTES "${BIN_HEX}")
    # shader bytecode is read as DWORDs
    string(APPEND ARRAYS "alignas(4) static const unsigned char kShader${INDEX}[] = {${BIN_BYTES}};\n")
    string(APPEND TABLE "    {\"${BIN_NAME}\", kShader${INDEX}, sizeof(kShader${INDEX})},\n")
    math(EXPR INDEX "${INDEX} + 1")
endforeach()

file(WRITE "${OUTPUT}"
"// Generated by cmake/embed_shaders.cmake from the shaders compiled in src/shader/hlsl, do not edit.
#include \"shader/compiled_shaders.h\"

namespace ssa::CompiledShaders
{
${ARRAYS}
const Shader kShaders[] = {
${TABLE}    {nullptr, nullptr, 0}, // end marker, an empty array is not valid C++
};
} // namespace ssa::CompiledShaders
")
